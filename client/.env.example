# Supabase project (Settings -> API in your Supabase dashboard)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Base URL of the Express backend, including the /api prefix.
# Local dev:  http://localhost:4000/api
# Production: https://your-render-service.onrender.com/api
#
# Read at BUILD time by Vite (client/src/lib/api.js) — on Netlify this
# must be set as a build-time environment variable (Site settings ->
# Build & deploy -> Environment) before building, not something you can
# change post-deploy without triggering a new build/redeploy.
VITE_API_URL=http://localhost:4000/api
