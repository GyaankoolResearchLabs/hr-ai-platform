# Supabase project (Settings -> API in your Supabase dashboard)
SUPABASE_URL=https://your-project.supabase.co
# Service role key - server-side only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Port the Express API listens on
PORT=4000

# Frontend origin allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# Reserved for future AI provider integration (see src/services/aiService.js)
# ANTHROPIC_API_KEY=
