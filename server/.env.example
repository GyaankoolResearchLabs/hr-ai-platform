# =============================================================================
# REQUIRED — the server will not start without these
# =============================================================================

# Supabase project (Settings -> API in your Supabase dashboard)
SUPABASE_URL=https://your-project.supabase.co
# Service role key - server-side only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Anon/publishable key - used by POST /api/auth/login to call Supabase's
# password-grant endpoint. Without this, EVERY login attempt fails with a
# 500, not just wrong-password ones.
SUPABASE_ANON_KEY=your-supabase-anon-key

# The deployed frontend's exact origin (scheme + host, no trailing slash) —
# gates CORS and is used to build links in outgoing emails (invite accept
# URLs, etc.). In production this is your Netlify URL, e.g.
# https://your-app.netlify.app
CLIENT_ORIGIN=http://localhost:5173

# =============================================================================
# OPTIONAL — the server starts fine without these; only the specific
# feature that uses one fails (with a clear error) if it's missing.
# =============================================================================

# Port the Express API listens on. Render sets this automatically at
# deploy time — do not hardcode it there. Only used for local dev here.
PORT=4000

# node_env: development | production
NODE_ENV=development

# --- AI features -------------------------------------------------------
# routes/ai.js, jobDescription.js, resume screening, etc.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# services/learningService.js — AI Course Generator tool only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Outbound email (services/emailService.js) -------------------------
# Employee invites, notifications, etc.
RESEND_API_KEY=
EMAIL_FROM="HR AI Platform <onboarding@resend.dev>"

# --- Integration Hub (routes/integrationHub.js) -------------------------
# Symmetric key used to encrypt stored third-party integration
# credentials at rest. Generate with e.g. `openssl rand -hex 32`.
INTEGRATION_ENCRYPTION_KEY=

# --- JWT verification (middleware/auth.js) ------------------------------
# Only needed if your Supabase project still issues legacy HS256 JWTs
# (Settings -> API -> JWT Settings). Modern projects use ES256/RS256,
# verified automatically via Supabase's public JWKS — leave both blank.
SUPABASE_JWT_SECRET=
# Optional pinned copy of Supabase's JWKS JSON, to avoid a remote fetch
# on cold start / key rotation. Safe to leave unset — falls back to
# fetching https://<SUPABASE_URL>/auth/v1/.well-known/jwks.json.
SUPABASE_JWKS_JSON=

# --- Dev/test-only — NEVER set this to true in production --------------
# Gates a destructive test-only escalation-cleanup endpoint
# (routes/escalations.js). Leave unset (or false) in every real
# deployment.
ESCALATION_TEST_MODE=false
