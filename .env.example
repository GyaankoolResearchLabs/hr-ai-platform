# HR AI Platform — environment variables
# -----------------------------------------------------------------------
# This file documents every environment variable used across the project.
# The client and server each read their own .env file:
#   client/.env  (copy from client/.env.example)
#   server/.env  (copy from server/.env.example)
#
# Both are reproduced below for reference.

# ===== client/.env =====
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_URL=http://localhost:4000/api

# ===== server/.env =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# ANTHROPIC_API_KEY=   # reserved for future AI provider integration
